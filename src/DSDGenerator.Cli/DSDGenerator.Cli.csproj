<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DSDGenerator.Cli</RootNamespace>
    <AssemblyName>DSDGenerator</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DSDGenerator.Core\DSDGenerator.Core.csproj" />
    <ProjectReference Include="..\DSDGenerator.Logging\DSDGenerator.Logging.csproj" />
  </ItemGroup>

  <!--
    Assets/esp2dsd.exe кладётся пользователем вручную (в .gitignore).
    Копируем в output, если файл есть. Если нет — MSBuild просто
    пропустит (None + Condition).
  -->
  <ItemGroup>
    <None Include="..\..\Assets\esp2dsd.exe"
          Link="Assets\esp2dsd.exe"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\Assets\esp2dsd.exe')" />
  </ItemGroup>
</Project>